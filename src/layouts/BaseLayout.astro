---
import '@/styles/global.css';
import { SITE_CONFIG } from '@/config/site';
import { DEFAULT_LANGUAGE, getDictionary } from '@/i18n';
import { withBase } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
}

const defaultDict = getDictionary(DEFAULT_LANGUAGE);

const {
  title = SITE_CONFIG.name,
  description = defaultDict.meta.siteDescription,
} = Astro.props;

const pageTitle =
  title === SITE_CONFIG.name ? title : `${title} — ${SITE_CONFIG.name}`;
---

<!doctype html>
<html lang="bn" data-lang="bn" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var savedTheme = localStorage.getItem('cs:theme');
          var theme =
            savedTheme === 'dark' || savedTheme === 'light'
              ? savedTheme
              : 'light';
          document.documentElement.setAttribute('data-theme', theme);

          var savedLang = localStorage.getItem('cs:lang');
          var lang = savedLang === 'en' || savedLang === 'bn' ? savedLang : 'bn';
          document.documentElement.lang = lang;
          document.documentElement.setAttribute('data-lang', lang);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-canvas text-ink antialiased selection:bg-accent-subtle selection:text-accent-ink">
    <a
      href="#workspace-main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-1.5 focus:rounded-sm focus:bg-surface focus:text-ink focus:border focus:border-accent focus:text-[12px] focus:font-medium"
    >
      {defaultDict.meta.skipToWorkspace}
    </a>
    <slot />
  </body>
</html>
